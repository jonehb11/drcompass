      "outboundCalls": [
        { "target": "settlement SFTP (bank partner)", "type": "third-party", "protocol": "sftp", "purpose": "ERA file exchange", "failoverBehavior": "static egress IP — partner allowlist", "critical": true }
      ],
      "awsServices": ["EKS", "S3", "SQS", "Transfer Family"],
      "secrets": [{ "name": "remittance/sftp-key", "arn": "", "replicated": "yes", "notes": "" }],
      "endpoints": [],
      "verification": { "command": "kubectl logs -n remittance -l app=remittance --tail=30", "pass": "import/settle activity visible" },
      "gaps": [], "notes": "ERA import is a separate path from claims — test both.", "tags": ["success-bar"]
    },
