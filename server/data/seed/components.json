{
  "items": [
    {
      "id": "cmp_eks", "name": "primary-workload EKS cluster", "category": "compute", "tier": 0,
      "owner": "platform", "team": "Platform Engineering", "kind": "eks-cluster",
      "description": "Main EKS cluster: istio mesh, AWS Load Balancer Controller, CoreDNS, Karpenter, ~600 workloads across 10 namespaces.",
      "drStrategy": "inherit", "restoreLayer": "L2",
      "replication": { "mechanism": "arpio-resource-graph", "rpoMinutes": 30, "notes": "Cluster shape restored from Arpio graph + IaC; ~40 min cold start observed" },
      "inRecoveryScope": "yes", "definedIn": "terraform/eks-setup",
      "dependsOn": ["cmp_vpc", "cmp_iam", "cmp_ecr", "cmp_secrets"],
      "outboundCalls": [
        { "target": "ECR (recovery account)", "type": "aws-service", "protocol": "https", "purpose": "image pulls at pod start", "failoverBehavior": "must point at recovery-region registry", "critical": true },
        { "target": "Secrets Manager", "type": "aws-service", "protocol": "https", "purpose": "secrets-init at pod start", "failoverBehavior": "explicit ARNs must exist in recovery region", "critical": true }
      ],
      "awsServices": ["EKS", "EC2", "Karpenter", "ELB"],
      "secrets": [],
      "endpoints": [],
      "verification": { "command": "kubectl get nodes && kubectl get pods -n kube-system", "pass": "nodes Ready; CoreDNS/istiod/ALB controller Running" },
      "gaps": [], "notes": "", "tags": ["platform"]
    },
    {
      "id": "cmp_adjudication", "name": "adjudication-service", "category": "compute", "tier": 0,
      "owner": "claims", "team": "Claims", "kind": "eks-workload",
      "description": "Answers pharmacy claims (the business success bar). A claim answered end-to-end proves the platform works.",
      "drStrategy": "inherit", "restoreLayer": "L4",
      "replication": { "mechanism": "arpio-snapshot", "rpoMinutes": 30, "notes": "" },
      "inRecoveryScope": "yes", "definedIn": "terraform/services/adjudication",
      "dependsOn": ["cmp_eks", "cmp_aurora_adj", "cmp_redis_adj", "cmp_sqs_claims", "cmp_secrets", "cmp_pharmacy", "cmp_pricing"],
      "outboundCalls": [
        { "target": "partner clearinghouse", "type": "third-party", "protocol": "https", "purpose": "claim switch traffic (inbound partner, outbound ack)", "failoverBehavior": "partner must allowlist recovery egress IPs", "critical": true },
        { "target": "Aurora adjudication DB", "type": "aws-service", "protocol": "postgres", "purpose": "claims state", "failoverBehavior": "restored from aligned recovery point", "critical": true },
        { "target": "Kinesis claim stream", "type": "aws-service", "protocol": "https", "purpose": "claim event fan-out", "failoverBehavior": "NOT in recovery scope — known gap", "critical": false }
      ],
      "awsServices": ["EKS", "Secrets Manager", "SQS", "Kinesis"],
      "secrets": [
        { "name": "adjudication/db-password", "arn": "", "replicated": "yes", "notes": "" },
        { "name": "adjudication/partner-api-key", "arn": "", "replicated": "unknown", "notes": "reconcile — three secret lists disagree" }
      ],
      "endpoints": [{ "name": "claims API", "url": "", "healthCheck": "/api/switch/healthcheck" }],
      "verification": { "command": "curl -X POST .../ncpdp with test claim", "pass": "real claim response with claim_id (not internal_server_error)" },
      "gaps": ["Kinesis claim stream not in recovery scope — confirm whether adjudication needs it to answer a claim"],
      "notes": "", "tags": ["success-bar"]
    },
    {
      "id": "cmp_remittance", "name": "remittance-service", "category": "compute", "tier": 0,
      "owner": "claims", "team": "Claims", "kind": "eks-workload",
      "description": "Imports and settles remittances (ERA). Settlement completing is the second half of the success bar.",
      "drStrategy": "inherit", "restoreLayer": "L4",
