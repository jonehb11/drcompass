{
  "name": "drcompass",
  "version": "0.6.0",
  "description": "DR Compass — the disaster recovery planning studio. Inventory, dependencies, deployment order, diagrams, runbooks, tests, and exports for AWS multi-region DR.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "drcompass": "bin/drcompass.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/drcompass.js start --no-open",
    "dev": "node bin/drcompass.js start",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "mermaid": "^11.4.1",
    "open": "^10.1.0"
  },
  "files": [
    "bin/",
    "server/",
    "web/",
    "SPEC.md",
    "CHANGELOG.md",
    "ICON-CREDITS.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonehb11/drcompass.git"
  },
  "homepage": "https://github.com/jonehb11/drcompass#readme",
  "bugs": {
    "url": "https://github.com/jonehb11/drcompass/issues"
  },
  "keywords": [
    "disaster-recovery",
    "dr",
    "business-continuity",
    "aws",
    "multi-region",
    "kubernetes",
    "runbook",
    "failover",
    "region-switch",
    "arpio",
    "resilience",
    "rto",
    "rpo",
    "local-first",
    "cli"
  ]
}
